# Containerfile.web — nginx fronting the PHP-FPM service.
#
# Code is sourced from the previously-built psa-moodle-php image so nginx and
# php-fpm serve identical paths. Build order is enforced by the Makefile.

ARG PHP_IMAGE=localhost/psa-moodle-php:dev

FROM ${PHP_IMAGE} AS src

# =============================================================================
FROM nginxinc/nginx-unprivileged:1.27-alpine

# nginx-unprivileged runs as UID 101 ("nginx") by default and listens on 8080.
USER 0
RUN apk add --no-cache curl

COPY config/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=src /var/www/html /var/www/html

# Tighten file ownership so nginx can read static assets but not mutate code.
RUN chown -R 101:0 /var/www/html \
 && chmod -R g+rX /var/www/html

USER 101
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD curl -fsS http://localhost:8080/health || exit 1
