# Containerfile.web — nginx fronting the PHP-FPM service.
#
# Code is sourced from the previously-built psa-moodle-php image so nginx and
# php-fpm serve identical paths. Build order is enforced by the Makefile.

ARG PHP_IMAGE=localhost/psa-moodle-php:dev

FROM ${PHP_IMAGE} AS src

# =============================================================================
# nginx 1.30 (stable), unprivileged variant, slim (no dynamic modules; our config loads none).
# 1.30.7 fixes the November 2026 "nginx2root" advisories (CVE-2026-123007, CVE-2026-123633,
# CVE-2026-123634, CVE-2026-121810, CVE-2026-113425; https://nginx.org/en/security_advisories.html).
# Upstream moved this image from `nginxinc/` to `nginx/` on Docker Hub; `nginxinc/nginx-unprivileged`
# stopped at 1.30.6 / 1.31.7 and will not get security fixes. Same digest on ghcr.io/nginx/nginx-unprivileged.
# Pinned by multi-arch index digest so a rebuild cannot silently change the base.
FROM docker.io/nginx/nginx-unprivileged:1.30.7-alpine-slim@sha256:8432c57ac86f178741af2b89948bd9087cb9df1c415bc1ab4d23735c4f0e3e61

# nginx-unprivileged runs as UID 101 ("nginx") by default and listens on 8080.
USER 0
# Guard: fail the build if the base is not the expected nginx (e.g. after an unreviewed FROM change).
RUN nginx -v 2>&1 | grep -qx 'nginx version: nginx/1.30.7' \
 && apk add --no-cache curl

# The site config is a template: nginx's entrypoint (20-envsubst-on-templates.sh) writes conf.d/default.conf from it at
# start, substituting only PHP_UPSTREAM (C1). The base image's own default.conf is removed so the output can be written.
ENV PHP_UPSTREAM=php:9000 \
    NGINX_ENVSUBST_FILTER=^PHP_UPSTREAM$
RUN rm -f /etc/nginx/conf.d/default.conf
COPY config/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=src /var/www/html /var/www/html

# Tighten file ownership so nginx can read static assets but not mutate code.
RUN chown -R 101:0 /var/www/html \
 && chmod -R g+rX /var/www/html

USER 101
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD curl -fsS http://localhost:8080/health || exit 1
