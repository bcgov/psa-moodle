# Containerfile.ops — small image used by Phase 6 CronJobs.
#
# Provides:
#   - `oc` (cluster client; the ops CronJobs exec into Crunchy and Moodle pods)
#   - `swaks` (Perl-based SMTP client; talks unauth'd to apps.smtp.gov.bc.ca)
#   - bash + curl + jq for the orchestration scripts
#   - the scripts themselves, baked in at /usr/local/bin
#
# Built non-root. SCC reassigns UID at admission; group 0 has rwx where needed.

FROM docker.io/library/alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

# Kubernetes client: upstream kubectl, not Red Hat's oc. Even the newest oc 4.18 client carried 2 CRITICAL and 60 HIGH
# vulnerabilities in its bundled Go code (image-scan, 2026-11-25); kubectl 1.32 has no CRITICAL. 1.32 is within one minor
# of the clusters' Kubernetes 1.31 (OpenShift 4.18). The ops scripts only use get, exec, logs, apply, patch, wait and
# delete, which kubectl has, so `oc` is a link to it. Bump KUBECTL_VERSION when image-scan flags it; Dependabot can't.
ARG KUBECTL_VERSION=v1.32.13
ARG TARGETARCH

RUN apk add --no-cache \
      bash curl jq ca-certificates \
      perl perl-net-ssleay \
      tini \
      postgresql-client \
 && arch="${TARGETARCH:-amd64}" \
 && curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}/kubectl" \
 && echo "$(curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}/kubectl.sha256")  /usr/local/bin/kubectl" \
      | sha256sum -c - \
 && ln -s kubectl /usr/local/bin/oc \
 && curl -fsSL -o /usr/local/bin/swaks \
      https://raw.githubusercontent.com/jetmore/swaks/v20240103.0/swaks \
 && chmod 755 /usr/local/bin/swaks /usr/local/bin/kubectl

# Helper scripts the CronJobs invoke.
COPY scripts/ops/ /usr/local/bin/

RUN chmod +x /usr/local/bin/*.sh \
 && adduser -D -u 1001 -g 0 ops \
 && chown -R ops:0 /home/ops \
 && chmod -R g+rwX /home/ops

USER 1001
WORKDIR /home/ops
ENTRYPOINT ["/sbin/tini", "--"]
